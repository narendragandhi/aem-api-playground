# Copy this file to `.env` in the working directory and adjust values.
# The CLI loads `.env` from the current directory at startup (via --env-file
# for custom paths). All variables are optional.

# Logging (defaults: level=info, file="-")
AEM_LOG_LEVEL=warn
AEM_LOG_FILE=-

# Active environment and connection defaults
AEM_ENV=dev
AEM_TIMEOUT=30

# Debug mode
AEM_DEBUG=false

# Master key used to encrypt stored credentials (min 32 chars).
# If unset, a key is generated and stored in ~/.aem-api/.key.
# AEM_API_MASTER_KEY=replace-with-a-long-random-secret

# AI agent providers (optional)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
